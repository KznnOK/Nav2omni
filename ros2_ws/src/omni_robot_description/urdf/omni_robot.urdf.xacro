<?xml version="1.0"?>
<robot name="omni_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Comments must not contain colon-space. gazebo_ros2_control parses the
       whole description as a YAML parameter value. -->

  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="geometry_file"
    default="$(find omni_robot_description)/config/robot_geometry.yaml"/>

  <!-- All dimensions come from robot_geometry.yaml -->
  <xacro:property name="geom" value="${xacro.load_yaml('$(arg geometry_file)')}"/>

  <xacro:property name="base_length" value="${geom['chassis']['length']}"/>
  <xacro:property name="base_width" value="${geom['chassis']['width']}"/>
  <xacro:property name="base_height" value="${geom['chassis']['height']}"/>
  <xacro:property name="base_center_z"
    value="${geom['chassis']['ground_clearance'] + 0.5 * base_height}"/>

  <xacro:property name="wheel_radius" value="${0.5 * geom['drive_wheels']['diameter']}"/>
  <xacro:property name="wheel_width" value="${geom['drive_wheels']['width']}"/>
  <xacro:property name="wheel_mass" value="${geom['mass']['drive_wheel']}"/>
  <xacro:property name="wheel_distance" value="${geom['drive_wheels']['center_distance']}"/>
  <!-- Wheel axle height relative to base_link (base_footprint is on the floor) -->
  <xacro:property name="wheel_z" value="${wheel_radius - base_center_z}"/>
  <xacro:property name="max_wheel_speed" value="${geom['drive_wheels']['max_wheel_speed']}"/>

  <!-- Chassis carries the remaining mass -->
  <xacro:property name="base_mass" value="${geom['mass']['total'] - 4 * wheel_mass}"/>

  <!-- base_footprint on the floor, below the robot center -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_center_z}" rpy="0 0 0"/>
  </joint>

  <!-- base_link at the chassis center -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>

      <material name="blue">
        <color rgba="0.2 0.4 0.9 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <!-- Solid box -->
      <inertia
        ixx="${base_mass * (base_width**2 + base_height**2) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_mass * (base_length**2 + base_height**2) / 12.0}"
        iyz="0.0"
        izz="${base_mass * (base_length**2 + base_width**2) / 12.0}"/>
    </inertial>

  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Wheel macro. index selects the entry in robot_geometry.yaml -->

  <xacro:macro name="wheel" params="index">

    <xacro:property name="name"
      value="${geom['drive_wheels']['names'][index]}_wheel"/>
    <xacro:property name="angle"
      value="${radians(geom['drive_wheels']['position_angles_deg'][index])}"/>

    <link name="${name}">

      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <!-- Solid cylinder, axle along y -->
        <inertia
          ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_mass * wheel_radius**2 / 2.0}"
          iyz="0.0"
          izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12.0}"/>
      </inertial>

    </link>

    <!-- Axle is radial (local y), so the rolling direction is angle - 90 deg.
         Diagonal wheels share one axle line through the center. -->
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>

      <origin
        xyz="${wheel_distance * cos(angle)} ${wheel_distance * sin(angle)} ${wheel_z}"
        rpy="0 0 ${atan2(sin(angle - pi / 2), cos(angle - pi / 2))}"/>

      <axis xyz="0 1 0"/>

      <limit
        effort="${geom['drive_wheels']['max_wheel_torque']}"
        velocity="${max_wheel_speed * 1.5}"/>

      <dynamics
        damping="0.02"
        friction="0.0"/>
    </joint>

    <gazebo reference="${name}">
      <material>Gazebo/Black</material>

      <!-- Omni wheel approximation. fdir1 is given in the collision frame,
           where z is the axle. The axle does not turn while the wheel spins,
           so mu1 stays along the free rollers and mu2 along rolling. -->
      <mu1>${geom['drive_wheels']['mu_axle']}</mu1>
      <mu2>${geom['drive_wheels']['mu_rolling']}</mu2>
      <fdir1>0 0 1</fdir1>

      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>

  </xacro:macro>

  <!-- Four omni wheels in X configuration -->

  <xacro:wheel index="0"/>
  <xacro:wheel index="1"/>
  <xacro:wheel index="2"/>
  <xacro:wheel index="3"/>

  <!-- Visible LiDAR body -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>

      <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
      </material>
    </visual>

  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!--
    Invisible scan origin.

    The visible LiDAR remains on the robot.
    The scan origin is placed forward and lower so that the low field walls
    can be detected without the laser intersecting the robot body.
  -->

  <link name="lidar_scan_link"/>

  <joint name="lidar_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_scan_link"/>
    <origin xyz="0.38 0.0 -0.10" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_scan_link">

    <sensor name="lidar_sensor" type="ray">

      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>

      <ray>

        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.08</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>

      </ray>

      <plugin
        name="gazebo_ros_lidar"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_scan_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>

  <!-- IMU frame -->

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${geom['imu']['xyz'][0]} ${geom['imu']['xyz'][1]} ${geom['imu']['xyz'][2]}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>100.0</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin
        name="gazebo_ros_imu_sensor"
        filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data_raw_gazebo</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ground truth pose of base_footprint (simulation only) -->

  <gazebo>
    <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>100.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- ros2_control -->

  <xacro:macro name="velocity_joint" params="index">
    <xacro:property name="pid" value="${geom['drive_wheels']['velocity_pid']}"/>
    <joint name="${geom['drive_wheels']['names'][index]}_wheel_joint">
      <!-- velocity_pid turns the velocity command into joint torque limited
           by the joint effort limit, like a motor with a speed controller -->
      <param name="vel_kp">${pid['kp']}</param>
      <param name="vel_ki">${pid['ki']}</param>
      <param name="vel_kd">${pid['kd']}</param>
      <param name="vel_max_integral_error">${pid['max_integral_error']}</param>
      <param name="vel_min_integral_error">${-pid['max_integral_error']}</param>
      <command_interface name="velocity_pid">
        <param name="min">${-max_wheel_speed * 1.5}</param>
        <param name="max">${max_wheel_speed * 1.5}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <xacro:velocity_joint index="0"/>
    <xacro:velocity_joint index="1"/>
    <xacro:velocity_joint index="2"/>
    <xacro:velocity_joint index="3"/>

  </ros2_control>

  <!-- gazebo_ros2_control -->

  <gazebo>

    <plugin
      name="gazebo_ros2_control"
      filename="libgazebo_ros2_control.so">

      <parameters>$(arg controllers_file)</parameters>

    </plugin>

  </gazebo>

</robot>
