<?xml version="1.0"?>

<sdf version="1.7">

  <model name="harurobo_field">

    <static>true</static>

    <link name="field_link">

      <pose>0 0 0 0 0 0</pose>

      <visual name="field_visual">

        <geometry>
          <mesh>
            <uri>model://harurobo_field/meshes/harurobo_field.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.65 0.65 0.65 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>

      </visual>

      <collision name="field_collision">

        <geometry>
          <mesh>
            <uri>model://harurobo_field/meshes/harurobo_field.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>10.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>

        </surface>

      </collision>

    </link>

  </model>

</sdf>
