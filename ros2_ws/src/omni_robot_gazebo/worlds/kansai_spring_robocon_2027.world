<?xml version="1.0"?>
<sdf version="1.6">
  <world name="kansai_spring_robocon_2027">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <!-- Field generated from config/field_layout.yaml (rulebook figure 4).
         The original STL model (harurobo_field) is kept but no longer used. -->
    <include>
      <uri>model://kansai_field_2027</uri>
      <name>kansai_field_2027</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- /gazebo/set_entity_state etc. for moving the robot in tests -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>100.0</update_rate>
    </plugin>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
  </world>
</sdf>
