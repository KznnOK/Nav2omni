<?xml version="1.0"?>
<package format="3">
  <name>omni_robot_manual</name>
  <version>0.0.0</version>
  <description>Manual PS4 and keyboard control for the omni robot</description>
  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>omni_robot_gazebo</exec_depend>
  <exec_depend>omni_robot_description</exec_depend>
  <exec_depend>omni_robot_nav2</exec_depend>
  <exec_depend>python3-pygame</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
