Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.5 m)
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 14
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.6
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        lidar_scan_link:
          Value: true
        tracking_x_wheel:
          Value: true
        tracking_y_wheel:
          Value: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan raw (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 120; 120; 120
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan filtered (/scan_filtered)
      Enabled: true
      Topic:
        Value: /scan_filtered
        Reliability Policy: Best Effort
        Depth: 5
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
        Depth: 5
      Color: 0; 180; 255
      Shape: Arrow (Flat)
      Arrow Length: 0.1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (/ground_truth/odom)
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Reliability Policy: Reliable
        Depth: 5
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 255; 255
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: EKF (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Depth: 5
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 0; 220; 0
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Drive wheels (/wheel/odom)
      Enabled: false
      Topic:
        Value: /wheel/odom
        Reliability Policy: Reliable
        Depth: 5
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 60; 120; 255
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Tracking wheels (/tracking/odom)
      Enabled: false
      Topic:
        Value: /tracking/odom
        Reliability Policy: Reliable
        Depth: 5
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 150; 0
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Mission path (/mission/path)
      Enabled: true
      Topic:
        Value: /mission/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color: 255; 0; 255
      Line Style: Lines
      Pose Style: Axes
      Axes Length: 0.15
      Axes Radius: 0.015
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Mission target (/mission/target)
      Enabled: true
      Topic:
        Value: /mission/target
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Shape: Arrow
      Color: 255; 255; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      X: -1.8
      Y: -0.5
      Scale: 110
      Angle: 0
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Displays:
    collapsed: false
  Views:
    collapsed: true
